{
    "compilerOptions": {
        "outDir": "./build",
        "target": "ESNext",
        "types": ["node"],
        "module": "ESNext",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "*": ["./types/*"]
        }
    },
    "ts-node": {
        "esm": true,
        "experimentalSpecifierResolution": "node"
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
}
